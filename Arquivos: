<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora JavaScript</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="calculadora">
        <input type="text" id="display" disabled>
        
        <div class="botoes">
            <button onclick="limpar()" class="btn clear">C</button>
            <button onclick="apagar()" class="btn">⌫</button>
            <button onclick="adicionarOperador('/')" class="btn operator">÷</button>
            <button onclick="adicionarOperador('*')" class="btn operator">×</button>
            
            <button onclick="adicionarNumero('7')" class="btn">7</button>
            <button onclick="adicionarNumero('8')" class="btn">8</button>
            <button onclick="adicionarNumero('9')" class="btn">9</button>
            <button onclick="adicionarOperador('-')" class="btn operator">-</button>
            
            <button onclick="adicionarNumero('4')" class="btn">4</button>
            <button onclick="adicionarNumero('5')" class="btn">5</button>
            <button onclick="adicionarNumero('6')" class="btn">6</button>
            <button onclick="adicionarOperador('+')" class="btn operator">+</button>
            
            <button onclick="adicionarNumero('1')" class="btn">1</button>
            <button onclick="adicionarNumero('2')" class="btn">2</button>
            <button onclick="adicionarNumero('3')" class="btn">3</button>
            <button onclick="calcular()" class="btn igual">=</button>
            
            <button onclick="adicionarNumero('0')" class="btn zero">0</button>
            <button onclick="adicionarNumero('.')" class="btn">.</button>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
